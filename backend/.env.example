# Copy to .env and load it (for example `set -a; . ./.env; set +a`) before starting uvicorn.
MARGA_DATA_DIR=data
DATABASE_URL=sqlite:///data/marga.db

# Sign-in (OpenID Connect). Register {MARGA_PUBLIC_URL}/api/auth/callback as the redirect URI at your provider.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
MARGA_PUBLIC_URL=http://localhost:3000
MARGA_COOKIE_SECURE=false              # must be true when served over HTTPS
MARGA_BOOTSTRAP_OWNER_EMAIL=you@example.com   # first sign-in with this email creates the first organisation
# MARGA_ALLOWED_EMAIL_DOMAINS=example.com
# MARGA_ALLOW_SELF_SIGNUP=false

# AI (optional unless MARGA_REQUIRE_GEMMA=true)
GEMMA_API_KEY=
# MARGA_REQUIRE_GEMMA=true
